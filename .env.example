# Monitor configuration.
#
# The installer writes this file for you as .env with chmod 600. It lives in the
# project root — one level above public/ — so it is never reachable over the web.
# Copy it by hand only if you are deploying without the installer.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://monitor.example.com

# Generated by the installer. Encrypts secrets stored in the database
# (SMTP password, and later the Entra client secret).
APP_KEY=

APP_TIMEZONE=UTC
APP_LOCALE=en

# The database password goes on the DB_PASS line below.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=monitor-db
DB_USER=user-db-monitor
DB_PASS=
DB_PREFIX=

# Optional: point the Microsoft Entra ID integration at a stand-in directory
# for testing. Leave both unset to use Microsoft's own endpoints.
# ENTRA_AUTHORITY_URL=
# ENTRA_GRAPH_URL=
